mod {
  wizards {
    newContentElement {
      wizardItems {

        gallery {
          # Title of the group in the left column of the new content element wizard
          header = LLL:EXT:anatolkin_mosaic_gallery/Resources/Private/Language/locallang_be.xlf:plugin.group

          # Place this group after the built-in "Plugins" group
          position = after:plugins

          elements {

            anatolkin_mosaic_gallery {
              iconIdentifier = mosaic-gallery-plugin
              title = LLL:EXT:anatolkin_mosaic_gallery/Resources/Private/Language/locallang_be.xlf:plugin.title
              description = LLL:EXT:anatolkin_mosaic_gallery/Resources/Private/Language/locallang_be.xlf:plugin.description

              tt_content_defValues {
                CType = list
                list_type = mosaicgallery_pi1
              }
            }

          }

          # Show our element inside this "Gallery" group
          show := addToList(anatolkin_mosaic_gallery)
        }

      }
    }
  }
}
