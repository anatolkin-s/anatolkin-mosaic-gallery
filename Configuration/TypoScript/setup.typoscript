plugin.tx_mosaicgallery_pi1 {
  view {
    templateRootPaths {
      10 = EXT:anatolkin_mosaic_gallery/Resources/Private/Templates/
    }
    partialRootPaths {
      10 = EXT:anatolkin_mosaic_gallery/Resources/Private/Partials/
    }
    layoutRootPaths {
      10 = EXT:anatolkin_mosaic_gallery/Resources/Private/Layouts/
    }
  }

  settings {
    # Runtime settings (0.4.x public API). These affect frontend rendering when a
    # FlexForm value is absent; they are NOT creation defaults for new records.
    source = folder
    folder = fileadmin/gallery/
    recursive = 1
    gap = 12

    # Site-specific defaults for NEW Mosaic Gallery content elements only.
    # Absent keys fall through to the FlexForm XML default. After the first save,
    # stored FlexForm values remain explicit and are not retroactively changed.
    #
    # defaults {
    #   gap = 20
    #   sortBy = name
    #   layoutMode = grid
    #   enableLightbox = 0
    #   frameWidth = 0
    # }
  }
}
